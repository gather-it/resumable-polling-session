{
  "name": "resumable-polling-session",
  "version": "0.1.0",
  "description": "A TypeScript polling scheduler with pause and resume, delivery checkpoints and bounded command queues.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/stages/*.test.mjs test/*.test.mjs",
    "verify:through": "node scripts/verify-through.mjs",
    "verify:polling:session-boundary": "node --test test/stages/01.test.mjs",
    "verify:polling:scope-isolation": "node --test test/stages/02.test.mjs",
    "verify:polling:lifecycle": "node --test test/stages/03.test.mjs",
    "verify:polling:abortable-waits": "node --test test/stages/04.test.mjs",
    "verify:polling:single-flight": "node --test test/stages/05.test.mjs",
    "verify:polling:stale-response": "node --test test/stages/06.test.mjs",
    "verify:polling:delivery-checkpoint": "node --test test/stages/07.test.mjs",
    "verify:polling:work-priority": "node --test test/stages/08.test.mjs",
    "verify:polling:continuation": "node --test test/stages/09.test.mjs",
    "verify:polling:command-deduplication": "node --test test/stages/10.test.mjs",
    "verify:polling:command-replacement": "node --test test/stages/11.test.mjs",
    "verify:polling:cadence": "node --test test/stages/12.test.mjs",
    "verify:polling:retry-policy": "node --test test/stages/13.test.mjs",
    "verify:polling:completion-events": "node --test test/stages/14.test.mjs",
    "verify:polling:standalone-release": "node --test test/stages/15.test.mjs",
    "pretest": "npm run build",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "demo": "npm run build && node examples/background-task.mjs",
    "check": "npm run typecheck && npm run typecheck:examples && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "keywords": [
    "polling",
    "typescript",
    "cancellation",
    "scheduler"
  ]
}
